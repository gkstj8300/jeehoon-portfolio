{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "paths": {
      "@jeehoon/ui": ["."],
    }
  },
  "include": ["**/*.ts", "**/*.tsx",],
  "exclude": ["node_modules", "dist"]
}